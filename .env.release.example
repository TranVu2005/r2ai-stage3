# Copy to .env (ignored by git) and edit the paths. Every R2AI path variable the release build reads (r2ai.paths).
# DATA/OUT/STATE hold the large inputs (out/runs/s36-fuse4, out/runs/s37, out/runs/s38-chunk-metric-v2 ... see README_RELEASE.md, "Required artifacts").
R2AI_DATA_DIR=D:/GitHub/r2ai-stage3/data
R2AI_OLD_ROOT=D:/GitHub/r2ai-stage3-old
R2AI_WORK_DATA_DIR=D:/GitHub/r2ai-stage3/data
R2AI_RAW_DIR=D:/GitHub/r2ai-stage3/data/raw_vi
R2AI_LEGACY_STATE_DIR=D:/GitHub/r2ai-stage3-old/state
R2AI_STATE_DIR=D:/GitHub/r2ai-stage3/state
R2AI_LEGACY_OUT_DIR=D:/GitHub/r2ai-stage3-old/out
R2AI_OUT_DIR=D:/GitHub/r2ai-stage3/out
R2AI_LOG_DIR=D:/GitHub/r2ai-stage3/out/logs
HF_HOME=C:/Users/Admin/.cache/huggingface
HF_HUB_OFFLINE=1
